mod <- glmer(
form.list[[i]],
data = df_list[[1]],
family = poisson
)
models[[i]] <- mod
r2 = r2_nakagawa(mod)
pois.summary.results[[i]] <-
glance(mod) %>%
add_column(condtional_R2 = r2$R2_conditional,
marginal_R2 = r2$R2_marginal,
Family = "Poisson",
RE = c("BirdID","Terr","BirdID+Terr")[i]
)
pois.random.results[[i]] <-
tidy(mod, effects = "ran_pars") %>%
add_column(
Family = "Poisson",
RE = c("BirdID","Terr","BirdID+Terr")[i]
)
pois.fixed.results[[i]] <-
tidy(mod, effects = "fixed") %>%
add_column(
Family = "Poisson",
RE = c("BirdID","Terr","BirdID+Terr")[i]
)
}
pois.summary.tbl <- bind_rows(pois.summary.results) %>% arrange(AIC)
pois.random.tbl  <- bind_rows(pois.random.results)
pois.fixed.tbl   <- bind_rows(pois.fixed.results)
kable(pois.summary.tbl)
kable(pois.random.tbl)
kable(pois.fixed.tbl)
aic_vec <- c(pois.summary.results[[1]]$AIC, pois.summary.results[[2]]$AIC,
pois.summary.results[[3]]$AIC)
delta_aic <- aic_vec - min(aic_vec)
delta_aic_pois[1, ] <- delta_aic
sim <- simulateResiduals(models[[1]])
plot(sim)
sim <- simulateResiduals(models[[2]])
plot(sim)
sim <- simulateResiduals(models[[3]])
plot(sim)
form.list <- list(
Fledge ~ factor(fac.yr) + (1 | birdID),
Fledge ~ factor(fac.yr) + (1 | Terrs),
Fledge ~ factor(fac.yr) + (1 | birdID) + (1 | Terrs)
)
pois.summary.results <- list()
pois.random.results  <- list()
pois.fixed.results   <- list()
models <- list()
for(i in seq_along(form.list)){
mod <- glmer(
form.list[[i]],
data = df_list[[2]],
family = poisson
)
models[[i]] <- mod
r2 = r2_nakagawa(mod)
pois.summary.results[[i]] <-
glance(mod) %>%
add_column(condtional_R2 = r2$R2_conditional,
marginal_R2 = r2$R2_marginal,
Family = "Poisson",
RE = c("BirdID","Terr","BirdID+Terr")[i]
)
pois.random.results[[i]] <-
tidy(mod, effects = "ran_pars") %>%
add_column(
Family = "Poisson",
RE = c("BirdID","Terr","BirdID+Terr")[i]
)
pois.fixed.results[[i]] <-
tidy(mod, effects = "fixed") %>%
add_column(
Family = "Poisson",
RE = c("BirdID","Terr","BirdID+Terr")[i]
)
}
library(ggplot2)
library(performance)
library(tidyverse)
library(glmmTMB)
library(mgcv)
library(emmeans)
library(DHARMa)
library(vcd)
library(broom)
library(broom.mixed)
library(caret)
library(ggfortify)
library(effects)
library(factoextra)
library(gridExtra)
library(corrplot)
library(kableExtra)
library(gratia)
library(lme4)
library(ggrepel)
df_list <- list()
probs <- read.csv("C:/Users/Thomsen.Bolton/Downloads/birdsimr/Terr/probs.csv", header = TRUE)
for (i in 1:52) {
df<- read.csv(paste0("C:/Users/Thomsen.Bolton/Downloads/birdsimr/Terr/sim_", i, ".csv"), header = TRUE)
df <- filter(df, Sex == "F")
df$birdID=factor(df$birdID)
df$Sex=factor(df$Sex)
df$Terrs=factor(df$Terrs)
df$fac.yr=factor(df$Yr)
# Calculate z-scores within each year
df <- df %>%
group_by(fac.yr) %>%
mutate(
z_score = (Fledge - mean(Fledge, na.rm = TRUE)) / sd(Fledge, na.rm = TRUE)
) %>%
ungroup()
df$Eggs <- ifelse(df$Fledge > 0, 1, 0)
df_list[[i]] <- df
}
delta_aic_pois <- matrix(rep(0, 52 * 3), nrow = 52, ncol = 3)
colnames(delta_aic_pois) <- c("BandID", "Terr", "BandID+Terr")
delta_aic_gaus <- matrix(rep(0, 52 * 3), nrow = 52, ncol = 3)
colnames(delta_aic_gaus) <- c("BandID", "Terr", "BandID+Terr")
delta_aic_binom <- matrix(rep(0, 52 * 3), nrow = 52, ncol = 3)
colnames(delta_aic_binom) <- c("BandID", "Terr", "BandID+Terr")
form.list <- list(
Fledge ~ factor(fac.yr) + (1 | birdID),
Fledge ~ factor(fac.yr) + (1 | Terrs),
Fledge ~ factor(fac.yr) + (1 | birdID) + (1 | Terrs)
)
pois.summary.results <- list()
pois.random.results  <- list()
pois.fixed.results   <- list()
models <- list()
for(i in seq_along(form.list)){
mod <- glmer(
form.list[[i]],
data = df_list[[1]],
family = poisson
)
models[[i]] <- mod
r2 = r2_nakagawa(mod)
pois.summary.results[[i]] <-
glance(mod) %>%
add_column(condtional_R2 = r2$R2_conditional,
marginal_R2 = r2$R2_marginal,
Family = "Poisson",
RE = c("BirdID","Terr","BirdID+Terr")[i]
)
pois.random.results[[i]] <-
tidy(mod, effects = "ran_pars") %>%
add_column(
Family = "Poisson",
RE = c("BirdID","Terr","BirdID+Terr")[i]
)
pois.fixed.results[[i]] <-
tidy(mod, effects = "fixed") %>%
add_column(
Family = "Poisson",
RE = c("BirdID","Terr","BirdID+Terr")[i]
)
}
pois.summary.tbl <- bind_rows(pois.summary.results) %>% arrange(AIC)
pois.random.tbl  <- bind_rows(pois.random.results)
pois.fixed.tbl   <- bind_rows(pois.fixed.results)
kable(pois.summary.tbl)
kable(pois.random.tbl)
kable(pois.fixed.tbl)
aic_vec <- c(pois.summary.results[[1]]$AIC, pois.summary.results[[2]]$AIC,
pois.summary.results[[3]]$AIC)
delta_aic <- aic_vec - min(aic_vec)
delta_aic_pois[1, ] <- delta_aic
sim <- simulateResiduals(models[[1]])
plot(sim)
sim <- simulateResiduals(models[[2]])
plot(sim)
sim <- simulateResiduals(models[[3]])
plot(sim)
form.list <- list(
z_score ~ (1 | birdID),
z_score ~ (1 | Terrs),
z_score ~ (1 | birdID) + (1 | Terrs)
)
z.summary.results <- list()
z.random.results  <- list()
z.fixed.results   <- list()
models <- list()
for(i in seq_along(form.list)){
mod <- lmer(
form.list[[i]],
data = df_list[[1]]
)
models[[i]] <- mod
r2 = r2_nakagawa(mod)
z.summary.results[[i]] <-
glance(mod) %>%
add_column(
R2_conditional = r2$R2_conditional,
Family = "Gaussian",
RE = c("BirdID","Terr","BirdID+Terr")[i]
)
z.random.results[[i]] <-
tidy(mod, effects = "ran_pars") %>%
add_column(
Family = "Gaussian",
RE = c("BirdID","Terr","BirdID+Terr")[i]
)
z.fixed.results[[i]] <-
tidy(mod, effects = "fixed") %>%
add_column(
Family = "Gaussian",
RE = c("BirdID","Terr","BirdID+Terr")[i]
)
}
z.summary.tbl <- bind_rows(z.summary.results) %>% arrange(AIC)
z.random.tbl  <- bind_rows(z.random.results)
z.fixed.tbl   <- bind_rows(z.fixed.results)
kable(z.summary.tbl)
kable(z.random.tbl)
kable(z.fixed.tbl)
aic_vec <- c(z.summary.results[[1]]$AIC, z.summary.results[[2]]$AIC,
z.summary.results[[3]]$AIC)
delta_aic <- aic_vec - min(aic_vec)
delta_aic_gaus[1, ] <- delta_aic
sim <- simulateResiduals(models[[1]])
plot(sim)
sim <- simulateResiduals(models[[2]])
